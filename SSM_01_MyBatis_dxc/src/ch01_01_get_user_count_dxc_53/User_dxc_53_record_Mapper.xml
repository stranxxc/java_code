<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ch01_01_get_user_count_dxc_53.User_dxc_53_record_Mapper">
	<!-- 功能：多条件查询，实现方式二：使用Mapper传参数 -->
	<!-- 当传入为map时，要求使用的键名与占位符名称要一致。 -->

<!-- 功能：演示forEach，第一种array -->
	<select id="getUserList_by_userId_in_foreach_11_array_dxc" parameterType="java.util.Arrays" resultType="ch01_01_get_user_count_dxc_53.User_dxc_53_record">
		select a.user_id as userId,a.user_name as
		userName,a.user_sfzh
		from user_dxc_53_record a where a.user_id
		in
		<foreach collection="array" item="user_id" separator="," open="(" close=")">
			#{user_id}
		</foreach>
		(1,2,3,4)
		and a,userName like '%'+#{userName}+'%'
	</select>


<!-- 演示foreach用法，第二种list -->
<select id="getUserList_by_userId_in_foreach_03_map_test_13_dxc" parameterType="map" resultType="ch01_01_get_user_count_dxc_53.User_dxc_53_record">
