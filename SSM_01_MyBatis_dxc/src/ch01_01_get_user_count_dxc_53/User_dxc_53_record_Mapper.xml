	<!-- 功能：动态语句，详见教材30页 -->
	<update id="update_user_Info_by_userId_userName_userSfzh_test_10_dxc_53"
		parameterType="map">
		UPDATE a
		<set>
			<if test="user_new_name !=null and user_new_name !=''">
				a.user_name=#{user_new_name},
			</if>
			<if test="user_new_sfzh !=null and user_new_sfzh !=''">
				a.user_sfzh=#{user_new_sfzh},
			</if>
		</set>
		from user_dxc_53_record a
		where 1=1
		<!-- OGNL表达式：！=不等于，''空串 -->
		<if test="user_old_id != null and user_old_id !='' ">
			and a.user_id=#{user_old_id}
		</if>

		<if test="user_old_name !=null and user_old_name !=''">
			and a.user_name=#{user_old_name}
		</if>

		<if test="user_old_sfzh !=null and user_old_sfzh != '' ">
			and a.user_sfzh=#{user_old_sfzh}
		</if>


	</update>

	<!-- 功能：定义，表的字段与pojo类的属性，绑定对应关系 -->
	<resultMap type="ch01_01_get_user_count_dxc_53.User_dxc_53_record"
		id="user_record_to_user_dxc_53_map">

		<!-- column:表的字段名，property：类的属性名 -->
		<result column="userId" property="user_id" />
		<result column="userName" property="user_name" />
	</resultMap>

	<!-- 功能：演示当前数据表的字段名，与POJO类的属性名，不一致时，用resultMap属性来绑定对应关系 -->
	<select id="getUserInfo_by_user_id_resultMap_test_09_dxc_53"
		parameterType="int" resultMap="user_record_to_user_dxc_53_map">
		select a.user_id as userId,a.user_name
		as userName,a.user_sfzh
		user_dxc_01_record a where
		a.user_id=#{user_id}
	</select>

	<!-- 功能：插入新用户，到数据库。 -->
	<insert id="insert_new_user_dxc_53_by_pojo" parameterType="ch01_01_get_user_count_dxc_53.User_dxc_53_record">
		INSERT INTO [user_dxc_53_record]
		([user_name],
		[user_sfzh])
		VALUES
		(#{user_name}
		,#{user_sfzh})
	</insert>

	<select id="getUserInfo_By_userId_userName_02_Map_dxc_53"
		parameterType="map" resultType="ch01_01_get_user_count_dxc_53.User_dxc_53_record">
		select * from user_dxc_53_record a
		where a.user_id &gt;=
		#{user_id_map} and
		a.user_name like
		'%'+#{user_name_map}+'%'
	</select>
