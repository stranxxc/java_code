package ch11_04_annotation_dxc_53;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.multipart.MultipartFile;

@Controller
public class File_upload_controller_dxc {
    //MultipartFile对象需要在springmvc中配置文件中配置文件上传的解析器
    @RequestMapping("/file_upload.do")
    public String file_upload_server(
            @RequestParam("upload_user_name") String upload_user_name,
            HttpServletRequest request, 
            HttpServletResponse response,
            HttpSession session, 
            Model model,
            @RequestParam("upload_file") MultipartFile upload_file) {
        
        String original_file_name = upload_file.getOriginalFilename();
        //第二步：定义存储位置
        String upload_path=request.getSession().getServletContext().getRealPath("/upload_file");
        
        System.out.println("---> " + original_file_name);
        
        // 将文件名存储到模型中，以便在JSP页面中使用
        model.addAttribute("fileName", original_file_name);
        model.addAttribute("userName", upload_user_name);
        
        return "file_upload_mvc_dxc";  // 不需要 .jsp 后缀，视图解析器会自动处理
    }
}